# ==============================================================================
# BISHI BACKEND ENVIRONMENT CONFIGURATION (.env.example)
#
# NOTE: The server is designed to boot out-of-the-box with NONE of these variables
# set. If unset, it automatically falls back to an embedded in-memory MongoDB
# (MongoMemoryServer) and deterministic Ethereum Sepolia relayer simulation mode.
# ==============================================================================

# Server Port (Default: 5001)
PORT=5001

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection URI
# When omitted or if local mongod is unreachable, falls back to MongoMemoryServer
MONGODB_URI=mongodb://127.0.0.1:27017/bishi_db

# JWT Secret for Signing and Verifying Authentication Tokens
# (Defaults to safe dev secret with console warning if unset; expiry 7 days)
JWT_SECRET=bishi_hyper_secure_jwt_token_secret_sepolia_2026

# Frontend Client Origin for CORS
# (Default Vite dev origins http://localhost:5173 and http://127.0.0.1:5173 are always allowed)
CLIENT_ORIGIN=http://localhost:5173

# Auto-seed database on start ('true' | 'false')
# Defaults to true in development and when using MongoMemoryServer
SEED_ON_START=true

# ------------------------------------------------------------------------------
# BLOCKCHAIN VERIFICATION LAYER (Ethereum Sepolia Testnet)
# ------------------------------------------------------------------------------

# Ethereum Sepolia Testnet JSON-RPC Endpoint (e.g. Alchemy, Infura, or Public RPC)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Server-Side Relayer Wallet Private Key
# When omitted or empty, blockchainService operates in High-Fidelity Deterministic
# Sepolia Fallback Mode (zero gas required, 100% deterministic SHA-256 anchoring).
RELAYER_PRIVATE_KEY=

# Deployed BishiTrustLedger Smart Contract Address on Ethereum Sepolia
CONTRACT_ADDRESS=0x892a014a51e605d3b6a98711ef84b01e3b52601a
LEDGER_CONTRACT_ADDRESS=0x892a014a51e605d3b6a98711ef84b01e3b52601a

# Blockchain Explorer Base URL
EXPLORER_BASE_URL=https://sepolia.etherscan.io

# ------------------------------------------------------------------------------
# CLOUDINARY COLLATERAL ASSET STORAGE (Private Authenticated Uploads)
# ------------------------------------------------------------------------------
# Sensitive member collateral documents are uploaded with type: "authenticated"
# and served exclusively via short-lived signed URLs (5 minutes expiry).
# When omitted, the server automatically falls back to secure local private disk
# storage under server/uploads/ with full SHA-256 integrity verification.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
